*.py[cod]
*$py.class
*.pyo

# Virtual environments and local environment files
.venv/
venv/
env/
.env
.env.*
!.env.example

# Test, coverage, and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Logs, local processes, and editor/OS files
*.log
*.pid
.DS_Store
.vscode/
.idea/

